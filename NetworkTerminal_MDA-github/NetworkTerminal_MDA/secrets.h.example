#pragma once

/*
 * NetworkTerminal_MDA Local Configuration
 *
 * 1. Copy this file to `secrets.h` in the same folder (`NetworkTerminal_MDA/secrets.h`).
 * 2. Fill in your own Wi-Fi, Telnet server, and optional auto-login settings below.
 * 3. `secrets.h` is listed in `.gitignore` so your credentials are never committed to Git.
 */

// Keyboard layout: "us", "uk", "de", "it", "es", "fr", "be", or "no"
#define KEYB_LAYOUT "us"

// Wi-Fi credentials (leave WIFI_SSID empty "" to skip auto-connecting on boot)
// Note: SSID and password must not contain spaces when used via the built-in `wifi` command.
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// Auto-connect Telnet target on boot (leave TELNET_HOST empty "" to stay at the `>` prompt)
#define TELNET_HOST "192.168.1.100"
#define TELNET_PORT 23

// Optional one-shot auto-login for TELNET_HOST on power-up
// WARNING: Telnet sends credentials in plaintext. Only enable on a trusted private LAN!
#define ENABLE_AUTO_LOGIN false
#define SERVER_USER "YOUR_USERNAME"
#define SERVER_PASS "YOUR_PASSWORD"
